VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Funding page display details (src/pages/dashboard/FundWallet.jsx).
# REQUIRED in production build environments (e.g. Cloudflare/Vercel) — they
# are compiled into the bundle at build time, not read at runtime.
VITE_BANK_NAME=
VITE_ACCOUNT_NAME=
VITE_ACCOUNT_NUMBER=
VITE_WHATSAPP_NUMBER=

GLADTIDINGS_TOKEN=
SERVICE_ROLE_KEY=
PROJECT_URL=

# Monnify automatic funding (Phase 1 - sandbox)
VITE_MONNIFY_ENABLED=false

# Markup mode for scripts/import-gladtidings-plans.cjs.
# Use only ONE of these two approaches at a time.

# Fixed markup (₦ per plan):
DEFAULT_MARKUP=20
DEFAULT_MARKUP_PERCENT=0

# Percentage markup (% of cost price) - uncomment to use instead:
# DEFAULT_MARKUP=0
# DEFAULT_MARKUP_PERCENT=8
